# Supabase project credentials — fill in from the Supabase dashboard.
# NEVER commit real keys. Copy this file to .env.local and fill it in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only key (used only in server code / seed script). Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
